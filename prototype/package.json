{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "db:turso:migrate": "node --env-file=.env.local scripts/migrate-turso.mjs",
    "db:turso:bootstrap": "node --env-file=.env.local scripts/bootstrap-turso.mjs",
    "db:turso:set-password": "node --env-file=.env.local scripts/set-turso-password.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tursodatabase/serverless": "1.4.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
