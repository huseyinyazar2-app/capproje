# Varsayilan calisma bicimi: uygulamanin kendi sunucusundaki yerel SQLite.
# Migration'lar uygulama acilisinda otomatik uygulanir, ayri bir komut gerekmez.
DATABASE_PROVIDER=sqlite

# ONEMLI: CAPPROJE_DATA_DIR kalici bir diske (Coolify/Docker volume) baglanmalidir.
# Aksi halde her yeni dagitimda veritabani, yuklenen dosyalar ve yedekler silinir.
CAPPROJE_DATA_DIR=/var/lib/capproje
SQLITE_DATABASE_PATH=/var/lib/capproje/capproje.sqlite
OBJECT_STORAGE_DIR=/var/lib/capproje/objects
SQLITE_BACKUP_DIR=/var/lib/capproje/backups
SQLITE_BACKUP_RETENTION_DAYS=30

HOST=127.0.0.1
PORT=3000
ALLOW_PUBLIC_BIND=false
MAX_REQUEST_BYTES=12582912
MAX_UPLOAD_BYTES=10485760

PASSWORD_AUTH_ENABLED=true
PASSWORD_AUTH_PEPPER=replace-with-a-long-random-secret
# Kendi sunucusunda PBKDF2 tur sayisi yukseltilebilir (100000-1000000). Her
# kaydin tur sayisi ayri saklandigi icin gecis kademelidir, mevcut sifreler
# bozulmaz. Cloudflare Workers 100000 uzerini reddeder.
PASSWORD_ITERATIONS=600000
PHONE_AUTH_ENABLED=false

BOOTSTRAP_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=false
EXPOSE_ERRORS=false

# On yuz farkli bir alan adindan sunuluyorsa buraya eklenmelidir.
# ALLOWED_ORIGINS=cap.taslak.online

# Turso yalnizca bulut onizlemesi icindir ve zorunlu degildir. Kullanilirsa
# migration'lar otomatik uygulanmaz; her dagitimdan sonra
# `npm run db:turso:migrate` calistirilmalidir.
# DATABASE_PROVIDER=turso
# TURSO_DATABASE_URL=libsql://database-organization.region.turso.io
# TURSO_AUTH_TOKEN=replace-with-a-secret-token
