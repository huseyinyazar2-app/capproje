{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd prototype && npm ci",
  "buildCommand": "cd prototype && npm run build",
  "outputDirectory": "prototype/dist/client",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
