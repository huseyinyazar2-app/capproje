{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd prototype && pnpm install --frozen-lockfile",
  "buildCommand": "cd prototype && pnpm run build",
  "outputDirectory": "prototype/dist/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
